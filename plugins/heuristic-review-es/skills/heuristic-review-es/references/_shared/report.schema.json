{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ancardenasc/ux-skills-es/schema/report.schema.json",
  "title": "ux-skills-findings",
  "description": "Bloque JSON que cierra cada informe de auditoría. Las claves siempre van en inglés; la prosa sigue el idioma de salida.",
  "type": "object",
  "required": ["schema_version", "skill", "language", "mode", "generated_on", "scope", "findings", "honest_gaps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "skill": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "language": { "enum": ["es", "en"] },
    "mode": { "enum": ["code", "url", "design", "mixed"] },
    "generated_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "scope": {
      "type": "object",
      "required": ["summary", "inputs", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "capabilities": {
          "type": "object",
          "required": ["browser", "figma", "axe", "script"],
          "additionalProperties": false,
          "properties": {
            "browser": { "type": "boolean" },
            "figma": { "type": "boolean" },
            "axe": { "type": "boolean" },
            "script": { "type": "boolean" }
          }
        }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "honest_gaps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "source_skill", "criterion", "status", "confidence", "method", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9]+-[0-9A-Za-z.]+-[0-9]{3}$" },
        "source_skill": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "criterion": {
          "type": "object",
          "required": ["system", "id", "name", "url"],
          "additionalProperties": false,
          "properties": {
            "system": { "enum": ["WCAG22", "NIELSEN"] },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "level": { "enum": ["A", "AA"] },
            "url": { "type": "string", "pattern": "^https://" }
          }
        },
        "status": { "enum": ["fail", "pass", "manual", "not_applicable", "not_tested"] },
        "severity": { "enum": ["critical", "serious", "moderate", "minor", "info"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "method": { "enum": ["static_code", "dom_runtime", "axe", "screenshot", "token_script", "design_context", "inferred"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["code", "dom", "screenshot", "measure", "design"] },
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "end_line": { "type": "integer", "minimum": 1 },
              "selector": { "type": "string" },
              "url": { "type": "string" },
              "snippet": { "type": "string", "maxLength": 300 },
              "measured": { "type": "object" }
            }
          }
        },
        "affected_users": { "type": "string" },
        "recommendation": { "type": "string" },
        "manual_check": {
          "type": "object",
          "required": ["reason", "procedure"],
          "additionalProperties": false,
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "procedure": { "type": "string", "minLength": 1 },
            "suggested_tools": { "type": "array", "items": { "type": "string" } }
          }
        },
        "dedup_key": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "fail" } }, "required": ["status"] },
          "then": { "required": ["severity", "description", "evidence", "recommendation"], "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "manual" } }, "required": ["status"] },
          "then": { "required": ["manual_check"] }
        }
      ]
    }
  }
}
